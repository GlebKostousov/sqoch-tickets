{
  "name": "sqoch-tickets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check . && npm run test:import-budget && npm run check:import-budget",
    "format": "prettier --write .",
    "test": "vitest run && npm run test:import-budget",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:import-budget": "node scripts/check-import-budget.mjs",
    "test:import-budget": "node --test scripts/check-import-budget.test.mjs",
    "verify": "npm run check && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.2.6",
    "@fontsource-variable/unbounded": "^5.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.56.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.13.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "5.57.2",
    "svelte-check": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
